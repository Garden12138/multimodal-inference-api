# Copy to .env and keep mode 600. Do not commit .env.
# Process environment overrides this file.
# API key priority: INFERENCE_API_KEY, then H3_MINIMAX_API_KEY only when the primary value is empty.

INFERENCE_API_KEY=
# H3_MINIMAX_API_KEY is a legacy alias and is ignored when INFERENCE_API_KEY is set.

# Empty INFERENCE_ALLOWED_CIDRS denies every address. The default below is loopback only.
INFERENCE_ALLOWED_CIDRS=127.0.0.1/32,::1/128
INFERENCE_PUBLIC_BASE_URL=http://127.0.0.1:8090

# V1 listens on 8090. Port 8089 is refused and stays with the existing service.
# This example binds loopback so a fresh local install is not exposed.
# On 104, set INFERENCE_HOST=0.0.0.0 and replace INFERENCE_ALLOWED_CIDRS
# with the approved LAN range. Do not put a real API key in this file.
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8090

INFERENCE_DATABASE_PATH=data/inference.db
INFERENCE_DATA_DIR=data

IMAGE_COMFYUI_BASE_URL=http://127.0.0.1:8190
VIDEO_COMFYUI_BASE_URL=http://127.0.0.1:8189

IMAGE_WORKERS=1
VIDEO_WORKERS=1

IMAGE_POLL_INTERVAL_SECONDS=3
VIDEO_POLL_INTERVAL_SECONDS=5

IMAGE_TASK_TIMEOUT_SECONDS=1800
VIDEO_TASK_TIMEOUT_SECONDS=3600

# Set to 1 only when callers may send resolution=768P and accept the verified 608x352 output.
# VIDEO_ALLOW_RESOLUTION_FALLBACK wins over H3_MM_ALLOW_RESOLUTION_FALLBACK.
VIDEO_ALLOW_RESOLUTION_FALLBACK=0
